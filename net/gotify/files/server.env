# Gotify OpenWrt defaults. Edit and restart: /etc/init.d/gotify restart
# Change GOTIFY_DEFAULTUSER_PASS immediately after first login.
# Data lives under /etc/gotify/data (persistent overlay). Do not use /var — it is tmpfs.

GOTIFY_LOGLEVEL=info
GOTIFY_SERVER_PORT=8080
GOTIFY_SERVER_LISTENADDR=

GOTIFY_DATABASE_DIALECT=sqlite3
GOTIFY_DATABASE_CONNECTION=/etc/gotify/data/gotify.db

GOTIFY_DEFAULTUSER_NAME=admin
GOTIFY_DEFAULTUSER_PASS=admin

GOTIFY_UPLOADEDIMAGESDIR=/etc/gotify/data/images
# Official plugin binaries are ABI-incompatible with this OpenWrt build.
GOTIFY_PLUGINSDIR=/etc/gotify/data/plugins

GOTIFY_REGISTRATION=false
NOCOLOR=1
