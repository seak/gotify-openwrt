#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/gotify
CONF=/etc/gotify/server.env
# OpenWrt: /var is a symlink to /tmp (tmpfs). Never use /var/lib for data.
DATADIR=/etc/gotify/data

start_service() {
	mkdir -p "$DATADIR/images" "$DATADIR/plugins"

	procd_open_instance
	procd_set_param command "$PROG" serve
	# Process env overrides server.env (incl. leftover /var/lib paths from old installs).
	procd_set_param env GOTIFY_CONFIG_FILE="$CONF"
	procd_append_param env GOTIFY_DATABASE_DIALECT=sqlite3
	procd_append_param env GOTIFY_DATABASE_CONNECTION="$DATADIR/gotify.db"
	procd_append_param env GOTIFY_UPLOADEDIMAGESDIR="$DATADIR/images"
	procd_append_param env GOTIFY_PLUGINSDIR="$DATADIR/plugins"
	procd_set_param file "$CONF"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "gotify"
}

reload_service() {
	stop
	start
}
